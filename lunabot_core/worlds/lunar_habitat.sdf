<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="lunar_habitat">

    <!-- ====================================================== -->
    <!-- LUNAR PHYSICS                                         -->
    <!-- ====================================================== -->

    <gravity>0 0 -1.62</gravity>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ====================================================== -->
    <!-- LUNAR SKY / LIGHTING                                  -->
    <!-- ====================================================== -->

    <scene>
      <ambient>0.08 0.08 0.10 1</ambient>
      <background>0.002 0.002 0.008 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="lunar_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>0.95 0.95 0.90 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.25 -1</direction>
    </light>

    <!-- ====================================================== -->
    <!-- 60 x 60 LUNAR SURFACE                                -->
    <!-- ====================================================== -->

    <model name="lunar_surface">
      <static>true</static>

      <link name="surface">

        <pose>0 0 -0.1 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>60 60 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>60 60 0.2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.34 0.34 0.36 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>

        </visual>

      </link>
    </model>

    <!-- ====================================================== -->
    <!-- HABITAT MODULE  (15,-16)                              -->
    <!-- ====================================================== -->

    <model name="habitat_module">
      <static>true</static>
      <pose>15 -16 1.5 0 0 0</pose>

      <link name="body">

        <collision name="collision">
          <geometry>
            <box>
              <size>7 5 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7 5 3</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.67 0.72 1</ambient>
            <diffuse>0.78 0.80 0.85 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>

        </visual>

      </link>
    </model>

    <!-- ====================================================== -->
    <!-- OXYGEN STATION  (18,14)                               -->
    <!-- ====================================================== -->

    <model name="oxygen_station">
      <static>true</static>
      <pose>18 14 1.4 0 0 0</pose>

      <link name="body">

        <collision name="collision">
          <geometry>
            <box>
              <size>5 5 2.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5 5 2.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.32 0.52 1</ambient>
            <diffuse>0.18 0.48 0.75 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>

        </visual>

      </link>
    </model>

    <!-- Oxygen tanks -->

    <model name="oxygen_tank_1">
      <static>true</static>
      <pose>21.2 13 1.5 0 0 0</pose>

      <link name="tank">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.65</radius>
              <length>3</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.65</radius>
              <length>3</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.55 0.65 0.72 1</ambient>
            <diffuse>0.65 0.75 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="oxygen_tank_2">
      <static>true</static>
      <pose>21.2 15 1.5 0 0 0</pose>

      <link name="tank">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.65</radius>
              <length>3</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.65</radius>
              <length>3</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.55 0.65 0.72 1</ambient>
            <diffuse>0.65 0.75 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================================================== -->
    <!-- RESEARCH ZONE (-15,18)                               -->
    <!-- ====================================================== -->

    <model name="research_zone">
      <static>true</static>
      <pose>-15 18 1.3 0 0 0</pose>

      <link name="body">

        <collision name="collision">
          <geometry>
            <box>
              <size>7 4 2.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7 4 2.6</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.50 0.28 1</ambient>
            <diffuse>0.78 0.70 0.30 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

    <!-- ====================================================== -->
    <!-- AIRLOCK (-18,-12)                                    -->
    <!-- ====================================================== -->

    <model name="airlock">
      <static>true</static>
      <pose>-18 -12 1.4 0 0 0</pose>

      <link name="body">

        <collision name="collision">
          <geometry>
            <box>
              <size>5 6 2.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5 6 2.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.38 0.42 0.48 1</ambient>
            <diffuse>0.52 0.58 0.65 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

    <!-- ====================================================== -->
    <!-- CENTRAL OBSTACLE FIELD                               -->
    <!-- ====================================================== -->

    <!-- Large boulder -->

    <model name="boulder_1">
      <static>true</static>
      <pose>3 5 1.2 0 0 0</pose>

      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere><radius>1.2</radius></sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere><radius>1.2</radius></sphere>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.22 0.22 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boulder_2">
      <static>true</static>
      <pose>-5 7 1.5 0 0 0</pose>

      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere><radius>1.5</radius></sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere><radius>1.5</radius></sphere>
          </geometry>
          <material>
            <ambient>0.13 0.13 0.14 1</ambient>
            <diffuse>0.24 0.24 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boulder_3">
      <static>true</static>
      <pose>7 -5 1.0 0 0 0</pose>

      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere><radius>1</radius></sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere><radius>1</radius></sphere>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.16 1</ambient>
            <diffuse>0.26 0.26 0.27 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boulder_4">
      <static>true</static>
      <pose>-8 -4 1.3 0 0 0</pose>

      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere><radius>1.3</radius></sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere><radius>1.3</radius></sphere>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.21 0.21 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boulder_5">
      <static>true</static>
      <pose>11 4 1.1 0 0 0</pose>

      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere><radius>1.1</radius></sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere><radius>1.1</radius></sphere>
          </geometry>
          <material>
            <ambient>0.14 0.14 0.15 1</ambient>
            <diffuse>0.23 0.23 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boulder_6">
      <static>true</static>
      <pose>-11 3 0.9 0 0 0</pose>

      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere><radius>0.9</radius></sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere><radius>0.9</radius></sphere>
          </geometry>
          <material>
            <ambient>0.13 0.13 0.14 1</ambient>
            <diffuse>0.23 0.23 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================================================== -->
    <!-- EQUIPMENT / NAVIGATION OBSTACLES                      -->
    <!-- ====================================================== -->

    <model name="equipment_crates">
      <static>true</static>
      <pose>3 -9 0.75 0 0 0.35</pose>

      <link name="crate">

        <collision name="collision">
          <geometry>
            <box><size>4 1.5 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>4 1.5 1.5</size></box>
          </geometry>

          <material>
            <ambient>0.35 0.24 0.08 1</ambient>
            <diffuse>0.55 0.38 0.10 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

    <model name="navigation_barrier_1">
      <static>true</static>
      <pose>1 10 0.75 0 0 0.5</pose>

      <link name="barrier">

        <collision name="collision">
          <geometry>
            <box><size>6 0.6 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>6 0.6 1.5</size></box>
          </geometry>

          <material>
            <ambient>0.55 0.28 0.05 1</ambient>
            <diffuse>0.80 0.42 0.08 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

    <model name="navigation_barrier_2">
      <static>true</static>
      <pose>-3 -10 0.75 0 0 -0.45</pose>

      <link name="barrier">

        <collision name="collision">
          <geometry>
            <box><size>5 0.6 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>5 0.6 1.5</size></box>
          </geometry>

          <material>
            <ambient>0.55 0.28 0.05 1</ambient>
            <diffuse>0.80 0.42 0.08 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

    <!-- ====================================================== -->
    <!-- SOLAR POWER ARRAY                                    -->
    <!-- ====================================================== -->

    <model name="solar_array">
      <static>true</static>
      <pose>-20 5 1.0 0.15 0 0</pose>

      <link name="panel">

        <collision name="collision">
          <geometry>
            <box><size>8 0.3 2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>8 0.3 2</size></box>
          </geometry>

          <material>
            <ambient>0.03 0.08 0.18 1</ambient>
            <diffuse>0.04 0.15 0.35 1</diffuse>
            <specular>0.45 0.45 0.55 1</specular>
          </material>

        </visual>

      </link>
    </model>

    <!-- ====================================================== -->
    <!-- COMMUNICATION TOWER                                  -->
    <!-- ====================================================== -->

    <model name="communication_tower">
      <static>true</static>
      <pose>0 22 3 0 0 0</pose>

      <link name="tower">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>6</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>6</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.45 0.45 0.48 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

    <!-- ====================================================== -->
    <!-- LUNABOT                                               -->
    <!-- ====================================================== -->

    <include>
      <uri>file:///home/yogka/lunabot_ws/src/lunabot_core/models/lunabot/model.sdf</uri>
      <name>lunabot</name>

      <!-- Start near centre of lunar base -->
      <pose>0 0 0.35 0 0 0</pose>

    </include>

  </world>

</sdf>

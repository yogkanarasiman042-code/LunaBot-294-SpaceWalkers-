<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="lunabot">

    <pose>0 0 0.35 0 0 0</pose>

    <!-- ==================== -->
    <!-- MAIN CHASSIS -->
    <!-- ==================== -->

    <link name="base_link">

      <inertial>
        <mass>20</mass>
        <inertia>
          <ixx>0.5</ixx>
          <iyy>1.0</iyy>
          <izz>1.0</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>1.2 0.8 0.3</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>1.2 0.8 0.3</size>
          </box>
        </geometry>
      </visual>

    </link>


    <!-- ==================== -->
    <!-- LEFT FRONT WHEEL -->
    <!-- ==================== -->

    <link name="left_front_wheel">
<pose>0.4 0.5 0 1.5708 0 0</pose>

      

      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- ==================== -->
    <!-- RIGHT FRONT WHEEL -->
    <!-- ==================== -->

    <link name="right_front_wheel">

<pose>0.4 -0.5 0 1.5708 0 0</pose>

      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- ==================== -->
    <!-- LEFT REAR WHEEL -->
    <!-- ==================== -->

    <link name="left_rear_wheel">

<pose>-0.4 0.5 0 1.5708 0 0</pose>

      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- ==================== -->
    <!-- RIGHT REAR WHEEL -->
    <!-- ==================== -->

    <link name="right_rear_wheel">

     <pose>-0.4 -0.5 0 1.5708 0 0</pose>

      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
nano ~/lunabot_ws/src/lunabot_core/models/lunabot/model.sdf        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- ==================== -->
    <!-- WHEEL JOINTS -->
    <!-- ==================== -->

    <joint name="left_front_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_front_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="right_front_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_front_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="left_rear_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_rear_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="right_rear_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_rear_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>
    <!-- ==================== -->
    <!-- LIDAR SENSOR -->
    <!-- ==================== -->

    <link name="lidar_link">

      <pose>0 0 0.35 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.05 0 0 0</pose>nano ~/lunabot_ws/src/lunabot_core/models/lunabot/model.sdf

        <topic>scan</topic>
        <update_rate>10</update_rate>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>

        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
    <!-- ==================== -->
    <!-- DIFFERENTIAL DRIVE -->
    <!-- ==================== -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_front_joint</left_joint>
      <left_joint>left_rear_joint</left_joint>

      <right_joint>right_front_joint</right_joint>
      <right_joint>right_rear_joint</right_joint>

      <wheel_separation>1.0</wheel_separation>
      <wheel_radius>0.2</wheel_radius>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

    </plugin>
    <!-- ==================== -->
    <!-- IMU SENSOR -->
    <!-- ==================== -->

    <link name="imu_link">

      <pose>0 0 0.25 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <sensor name="imu_sensor" type="imu">

        <topic>imu</topic>

        <update_rate>50</update_rate>

        <always_on>true</always_on>

      </sensor>

    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>
    <!-- ==================== -->
    <!-- FRONT CAMERA SENSOR -->
    <!-- ==================== -->

    <link name="camera_link">

      <pose>0.55 0 0.30 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.12 0.12 0.10</size>
          </box>
        </geometry>
      </visual>

      <sensor name="front_camera" type="camera">

        <topic>camera/image_raw</topic>

        <update_rate>15</update_rate>

        <camera>
          <horizontal_fov>1.39626</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.1</near>
            <far>30.0</far>
          </clip>
        </camera>

        <always_on>true</always_on>
        <visualize>true</visualize>

      </sensor>

    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
   
    <!-- CAMERA BLOCK HERE -->

  </model>
</sdf>
  </model>

</sdf>
